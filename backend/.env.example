# Copy these into your shell, IDE run configuration or hosting dashboard.
# Spring Boot does not read .env files on its own. Never commit real values.

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/libranet?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Required, at least 32 bytes. Generate one with: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more

# Comma-separated list of frontend origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# "dev" (default) wipes and reseeds demo data on every start. Use "prod" when deployed.
SPRING_PROFILES_ACTIVE=dev
# Password for the seeded admin@libranet.com account (dev profile only).
APP_SEED_ADMIN_PASSWORD=change-me
